# アプリケーション設定
APP_NAME=chabot
APP_ENV=production
DEBUG=False
API_VERSION=v1
# 管理UIはローカル開発時だけ明示的に有効化する。本番は認証実装までFalseを維持。
ADMIN_UI_ENABLED=False

# サーバー設定
HOST=0.0.0.0
PORT=8000

# データベース（本番環境: Cloud SQL for PostgreSQL）
# ※ 初期運用ではFirestore（DATABASE_BACKEND=firestore）を使用し、コスト削減
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chabot

# データベースバックエンド選択
# "firestore": Firestoreを使用（初期運用・無料枠内で運用可能）
# "postgresql": Cloud SQL for PostgreSQLを使用（本番運用）
DATABASE_BACKEND=firestore

# Firestore設定（DATABASE_BACKEND=firestore時使用）
FIRESTORE_PROJECT_ID=takahashi-451312
FIRESTORE_DATABASE_ID=chabotline

# JWT認証（カンマ区切りで複数指定可能）
JWT_SECRET_KEYS=your-secret-key-1,your-secret-key-2
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_KEY_ROTATION_DAYS=90

# LINE Messaging API
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_API_BASE_URL=https://api.line.me

# LINE Login（OIDC）
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-line-login-channel-secret
LINE_LOGIN_CALLBACK_URL=https://your-domain.com/api/v1/auth/line/callback

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# Price IDはStripe側の商品作成後に設定する。未設定中は登録URLに準備中画面を表示する。
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=https://your-domain.com/api/v1/subscription/success
STRIPE_CHECKOUT_CANCEL_URL=https://your-domain.com/api/v1/subscription/cancel

# Google Cloud Vertex AI
# 本番環境: Workload Identityを使用（GOOGLE_APPLICATION_CREDENTIALSは不要）
# 開発環境: ローカル認証を使用（gcloud auth application-default login）
GOOGLE_PROJECT_ID=takahashi-451312
# RAG Engine の GA リージョンは us-central1 / europe-west3 のみ
GOOGLE_LOCATION=us-central1

# コーパスID設定（重要: GOOGLE_CORPUS_IDがfree用、GOOGLE_CORPUS_ID_PLAN1が有料用）
GOOGLE_CORPUS_ID=6942545116196241408
GOOGLE_CORPUS_ID_PLAN1=1495705249682292736

# グラウンディング応答生成モデル（Gemini 3系はglobalエンドポイント経由で提供）
GOOGLE_MODEL_NAME=gemini-3.5-flash-lite
GOOGLE_GENERATION_LOCATION=global

# TypeSafe Jev（質問分類専用。APIキー取得後にサーバー側のSecret Managerから注入する）
# 未設定の間は分類なしでRAG回答を続行する。
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
# 評価済みのバージョンへ固定する。検証時に更新する。
JEV_MODEL_NAME=jev-1.13.0
JEV_TIMEOUT_SECONDS=5
JEV_CHOICE_CONFIDENCE_THRESHOLD=0.45
JEV_ASPECT_PROBABILITY_THRESHOLD=0.60

# CORS設定（JSON配列形式で複数指定可能）
# 本番環境: 実際のドメインを指定してください
CORS_ALLOWED_ORIGINS=["https://your-domain.com"]
