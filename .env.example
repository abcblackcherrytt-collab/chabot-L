# アプリケーション設定
APP_NAME=chabot
APP_ENV=production
DEBUG=False
API_VERSION=v1

# サーバー設定
HOST=0.0.0.0
PORT=8000

# データベース（本番環境: Cloud SQL for PostgreSQL）
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chabot

# JWT認証（カンマ区切りで複数指定可能）
JWT_SECRET_KEYS=your-secret-key-1,your-secret-key-2
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_KEY_ROTATION_DAYS=90

# LINE Messaging API
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_API_BASE_URL=https://api.line.me

# LINE Login（OIDC）
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-line-login-channel-secret
LINE_LOGIN_CALLBACK_URL=https://your-domain.com/api/v1/auth/line/callback

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Google Cloud Vertex AI
# 本番環境: Workload Identityを使用（GOOGLE_APPLICATION_CREDENTIALSは不要）
# 開発環境: ローカル認証を使用（gcloud auth application-default login）
GOOGLE_PROJECT_ID=your-project-id
# RAG Engine の GA リージョンは us-central1 / europe-west3 のみ
GOOGLE_LOCATION=us-central1
GOOGLE_CORPUS_ID=your-corpus-id
# グラウンディング応答生成モデル（モデルガーデンで最新IDを確認）
GOOGLE_MODEL_NAME=gemini-2.0-flash-001

# CORS設定（JSON配列形式で複数指定可能）
# 本番環境: 実際のドメインを指定してください
CORS_ALLOWED_ORIGINS=["https://your-domain.com"]
